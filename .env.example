# LLM provider: "ollama" (local) or "groq" (hosted API)
LLM_PROVIDER=ollama

# Ollama Configuration (copy this file to .env and adjust as needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Groq (hosted LLM API, free tier at https://console.groq.com)
# GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding provider: "ollama" (local server) or "huggingface" (local, no server)
EMBEDDING_PROVIDER=ollama
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# API server
API_HOST=0.0.0.0
API_PORT=8000